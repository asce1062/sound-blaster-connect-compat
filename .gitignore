# Pipeline outputs and working trees (all regenerated by the build)
/build/
/decompiled/

# apktool's per-user framework cache if it lands in-tree
/framework/

# Proprietary build inputs: the stock APK is supplied locally, never committed
/inputs/
*.apk
*.aab
*.xapk
*.apks

# Signing material and credentials (see SIGNING.md); never commit any of these
*.jks
*.keystore
*.p12
*.pfx
*.pk8
*.pem
*.key
keystore.properties
signing.properties
signing.env
*.signing.env
.env
.env.*
local.properties

# Signing byproducts
*.idsig

# Downloaded tooling (fetched + SHA-verified by the configure step)
/tools/

# Native and oracle build trees
patches/arm64/native/build/
oracle/build/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
